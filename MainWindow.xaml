<local:ThemedWindow x:Class="RunningPrograms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RunningPrograms"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{x:Static local:App.DisplayName}" Icon="Assets/SearchableTaskSwitcher.ico" Width="810" Height="640"
        MinWidth="310" MinHeight="470" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True" PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI" FontSize="14">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <local:ThemedWindow.Resources>
        <ControlTemplate x:Key="GitFilterRadioTemplate" TargetType="RadioButton">
            <DockPanel Background="Transparent">
                <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                    <Ellipse x:Name="SelectionDot" Width="6" Height="6" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" />
                </Grid>
                <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
            </DockPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </local:ThemedWindow.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,16" Text="{x:Static local:App.DisplayName}"
                   FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Background="Transparent" MouseLeftButtonDown="WindowHeading_MouseLeftButtonDown" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="_Add…" MinWidth="72" Padding="10,4" Margin="8,0,0,0"
                        Click="AddProgram_Click" ToolTip="Choose a running application to add to the dropdown." />
                <Label DockPanel.Dock="Left" Content="_Application" Target="{Binding ElementName=ProgramPicker}"
                       VerticalAlignment="Center" Padding="0,0,8,0" />
                <ComboBox x:Name="ProgramPicker" AutomationProperties.Name="Application" MinHeight="26" />
            </DockPanel>
            <TextBlock x:Name="ProgramStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Label x:Name="SearchLabel" Content="_Search by solution name" Target="{Binding ElementName=SolutionSearch}"
                   Padding="0,0,0,5" />
            <TextBox x:Name="SolutionSearch" Padding="8,5" PreviewKeyDown="ActivateOnlyResultOnEnter" />
            <WrapPanel x:Name="GitFilterPanel" Margin="0,10,0,0">
                <TextBlock Text="Git status" VerticalAlignment="Center" Margin="0,0,12,0" />
                <RadioButton x:Name="GitBoth" GroupName="GitStatusFilter" Content="Both" IsChecked="True" Margin="0,0,12,0"
                             Template="{StaticResource GitFilterRadioTemplate}"
                             ToolTip="Show all instances, including solutions outside Git repositories." />
                <RadioButton x:Name="GitUpToDate" GroupName="GitStatusFilter" Content="Up to date" Margin="0,0,12,0"
                             Template="{StaticResource GitFilterRadioTemplate}"
                             ToolTip="Show repositories with no pending local changes." />
                <RadioButton x:Name="GitWorkInProgress" GroupName="GitStatusFilter" Content="Work in progress" Margin="0,0,12,0"
                             Template="{StaticResource GitFilterRadioTemplate}"
                             ToolTip="Show repositories with pending local changes." />
                <RadioButton x:Name="GitNotARepo" GroupName="GitStatusFilter" Content="Not a repo"
                             Template="{StaticResource GitFilterRadioTemplate}"
                             ToolTip="Show solutions outside Git repositories." />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="12,0,28,6">
            <CheckBox x:Name="CheckAll" Content="Solution name" FontWeight="SemiBold" IsEnabled="False"
                      HorizontalAlignment="Left" VerticalContentAlignment="Center"
                      AutomationProperties.Name="Check all visible instances"
                      ToolTip="Check or uncheck all visible instances." />
            <TextBlock Text="PID" HorizontalAlignment="Right" FontWeight="SemiBold" />
        </Grid>

        <ListBox x:Name="ProcessList" Grid.Row="3"
                 ItemContainerStyle="{DynamicResource InstanceItemStyle}"
                 AutomationProperties.Name="Application window checklist"
                 PreviewKeyDown="ActivateOnlyResultOnEnter"
                 PreviewMouseLeftButtonDown="ProcessList_PreviewMouseLeftButtonDown"
                 PreviewMouseLeftButtonUp="ProcessList_PreviewMouseLeftButtonUp"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,8,10,3" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding AccessibleName}"
                                  VerticalContentAlignment="Center" ToolTip="{Binding Entry.Label}">
                            <TextBlock Text="{Binding Entry.Label}" TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                        <Border Grid.Column="1" Width="16" Height="16" Margin="12,0,0,0" Background="Transparent"
                                VerticalAlignment="Center" ToolTip="{Binding GitStatusText}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Entry.GitStatus}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M 8,1.5 A 6.5,6.5 0 1 1 8,14.5 A 6.5,6.5 0 1 1 8,1.5 Z M 6.2,6 C 6.2,4 9.9,3.9 9.9,6 C 9.9,7.4 8,7.4 8,8.8 M 8,11.1 L 8,11.3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Entry.GitStatus}" Value="Clean">
                                                <Setter Property="Data" Value="M 8,1.5 A 6.5,6.5 0 1 1 8,14.5 A 6.5,6.5 0 1 1 8,1.5 Z M 4.9,8 L 7,10.1 L 11.2,5.9" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Entry.GitStatus}" Value="Pending">
                                                <Setter Property="Data" Value="M 8,1.35 L 15.1,13.95 L 0.9,13.95 Z M 8,5.1 L 8,8.8 M 8,11.1 L 8,11.3" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Entry.GitStatus}" Value="NotRepository">
                                                <Setter Property="Data" Value="M 8,1.5 A 6.5,6.5 0 1 1 8,14.5 A 6.5,6.5 0 1 1 8,1.5 Z M 4.75,8 L 11.25,8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Entry.Id}"
                                   Margin="16,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Grid.Column="1" MinWidth="108" VerticalAlignment="Top" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button x:Name="RefreshButton" Content="_Refresh" Padding="12,5" Click="RefreshButton_Click"
                            ToolTip="Refresh the selected application's entries." ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="PullButton" Content="Pull" Margin="0,8,0,0" Padding="12,5" Click="PullButton_Click"
                            ToolTip="Pull the latest Git changes for the selected solution." ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="PublishButton" Content="Publish" Margin="0,8,0,0" Padding="12,5" Click="PublishButton_Click"
                            ToolTip="Choose an Azure Functions project from the selected solution's repository to publish." ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="CloseButton" Content="Close" Margin="0,8,0,0" Padding="12,5" Click="CloseButton_Click"
                            ToolTip="Close the checked visible entries, or the highlighted entry if none are checked." ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="DockButton" Content="Dock" Margin="0,8,0,0" Padding="12,5" Click="DockButton_Click"
                            ToolTip="Hide this window in the taskbar notification area." />
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="1" x:Name="ShortcutButton" Content="Shortcut" Margin="0,8,0,0" Padding="12,5"
                    Click="ShortcutButton_Click" ToolTip="Change the global shortcut." />
        </Grid>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <TextBlock x:Name="ProcessStatus" TextWrapping="Wrap" />
            <TextBlock x:Name="PullStatus" Margin="0,6,0,0" FontWeight="SemiBold"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="PublishStatus" Margin="0,6,0,0" FontWeight="SemiBold"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="CloseStatus" Margin="0,6,0,0" FontWeight="SemiBold"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <StatusBar Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0" FontSize="12"
                   AutomationProperties.Name="Keyboard shortcuts">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <WrapPanel Margin="4,1">
                    <TextBlock x:Name="OpenWindowShortcutText" Margin="0,0,16,0" />
                    <TextBlock x:Name="GitFilterShortcutText" Margin="0,0,16,0" />
                    <TextBlock Text="Hide window (Esc)" />
                </WrapPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</local:ThemedWindow>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <DefaultItemExcludes>$(DefaultItemExcludes);Libraries\**</DefaultItemExcludes>
    <RootNamespace>RunningPrograms</RootNamespace>
    <AssemblyName>SearchableTaskSwitcher</AssemblyName>
    <AssemblyTitle>Searchable Task Switcher</AssemblyTitle>
    <Product>Searchable Task Switcher</Product>
    <ApplicationIcon>Assets\SearchableTaskSwitcher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\SearchableTaskSwitcher.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Libraries\WindowSwitcher.Core\WindowSwitcher.Core.csproj" />
    <ProjectReference Include="Libraries\WindowSwitcher.Handlers.Chrome\WindowSwitcher.Handlers.Chrome.csproj" />
    <ProjectReference Include="Libraries\WindowSwitcher.Handlers.Devenv\WindowSwitcher.Handlers.Devenv.csproj" />
  </ItemGroup>
</Project>

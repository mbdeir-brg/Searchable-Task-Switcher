<local:ThemedWindow x:Class="RunningPrograms.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RunningPrograms"
        Title="Global Shortcut" Width="410" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="20">
        <Label Content="Press a _key combination" Target="{Binding ElementName=ShortcutInput}" Padding="0,0,0,6" />
        <TextBox x:Name="ShortcutInput" IsReadOnly="True" Padding="8,5" PreviewKeyDown="ShortcutInput_PreviewKeyDown" />
        <TextBlock Text="Use Ctrl, Alt, or Shift with another key, or choose a function key."
                   TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock x:Name="ShortcutError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,4" Margin="0,0,8,0"
                    ToolTip="Keep the current shortcut." />
            <Button Content="Save" IsDefault="True" MinWidth="80" Padding="10,4" Click="SaveButton_Click"
                    ToolTip="Save this key combination as the global shortcut." />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>

<local:ThemedWindow x:Class="RunningPrograms.AddProgramWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:RunningPrograms"
                    Title="Add application" Width="420" SizeToContent="Height" ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="20">
        <Label Content="_Applications with multiple windows or Chrome tabs" Target="{Binding ElementName=ApplicationList}"
               Padding="0,0,0,6" />
        <TextBlock x:Name="DiscoveryStatus" Text="Finding running applications…" TextWrapping="Wrap" />
        <ListBox x:Name="ApplicationList" Visibility="Collapsed" MinHeight="120" MaxHeight="260"
                 DisplayMemberPath="Label" SelectionChanged="ApplicationList_SelectionChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,4" Margin="0,0,8,0"
                    ToolTip="Dismiss the application picker." />
            <Button x:Name="AddButton" Content="Add" IsDefault="True" IsEnabled="False"
                    MinWidth="80" Padding="10,4" Click="Add_Click"
                    ToolTip="Add the selected application to the dropdown." ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>
